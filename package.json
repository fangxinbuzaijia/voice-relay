{
  "name": "voice-relay",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm -r --sort typecheck",
    "lint": "pnpm -r --sort lint",
    "test": "pnpm -r --sort test",
    "dev": "pnpm --filter @voice-relay/server dev",
    "dev:web": "pnpm --filter @voice-relay/web dev"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
