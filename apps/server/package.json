{
  "name": "@voice-relay/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "smoke:e2e": "node scripts/e2e-smoke.mjs",
    "smoke:account": "node scripts/account-smoke.mjs",
    "start": "node dist/index.js",
    "user:create": "tsx src/cli/create-user.ts",
    "user:reset": "tsx src/cli/reset-user.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "@voice-relay/protocol": "workspace:*",
    "argon2": "^0.44.0",
    "fastify": "^5.6.0",
    "otpauth": "^9.4.1",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5"
  }
}
